{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    { "source": "/es", "destination": "/es/index.html" },
    { "source": "/lots", "destination": "/lots/index.html" },
    { "source": "/es/terrenos", "destination": "/es/terrenos/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/es/blog", "destination": "/es/blog/index.html" },
    { "source": "/blog/:slug", "destination": "/blog/:slug/index.html" },
    { "source": "/es/blog/:slug", "destination": "/es/blog/:slug/index.html" }
  ]
}
